# ENVIRONMENT CONFIGURATION
NODE_ENV=production
LOG_LEVEL=INFO

# FRONTEND (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# BACKEND (services/api & services/worker)
PROJECT_NAME="Solana Meme Coin Autonomous Trader"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ALLOWED_ORIGINS="http://localhost:3000,https://*.vercel.app"

# DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solana_trader"

# SOLANA RPC & TRADING SETTINGS
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
TRADING_ENABLED=false
TRADING_PRIVATE_KEY=""

# THIRD PARTY APIS (OPTIONAL / PHASE 2+)
BIRDEYE_API_KEY=""
HELIUS_API_KEY=""
