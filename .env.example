# ENVIRONMENT CONFIGURATION
NODE_ENV=production
TRADING_ENV=production

# CORE SOLANA CONFIGURATION
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
TRADING_PRIVATE_KEY=Base58EncodedPrivateKeyStringDoNotShare

# DATABASE CONFIGURATION
DATABASE_URL=postgresql://trader_user:SecurePassword123@localhost:5432/solana_trading_db

# BACKEND API & SECURITY
API_SECRET_KEY=generate_a_random_64_character_hex_string_here
AUTH_SECRET=generate_a_random_jwt_secret_key_here
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# TRADING CONTROL FLAGS
TRADING_ENABLED=false
MAX_POSITION_SIZE_SOL=0.1
DAILY_LOSS_LIMIT_SOL=0.5
WEEKLY_LOSS_LIMIT_SOL=1.5
MAX_DRAWDOWN_PERCENT=10.0

# MARKET DATA APIS
BIRDEYE_API_KEY=your_birdeye_api_key
DEXSCREENER_API_URL=https://api.dexscreener.com/latest/dex
JUPITER_API_URL=https://quote-api.jup.ag/v6
