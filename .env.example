# ===========================================
# Solana AI Trader — Phase 2 Environment
# Copy this file to .env and fill the values
# NEVER commit the real .env file
# ===========================================

# PostgreSQL connection string (required for database)
# Example: postgresql://user:password@localhost:5432/solana_ai_trader
DATABASE_URL=

# Solana RPC (will be used in later phases)
SOLANA_RPC_URL=

# Market data providers (will be used in later phases)
BIRDEYE_API_KEY=
JUPITER_API_KEY=

# Optional: force trading status (leave empty for default BLOCKED)
# TRADING_STATUS=BLOCKED
